{
  "name": "fumii",
  "productName": "fumii",
  "version": "2.0.0",
  "description": "fumii — you're never really alone. Desktop companion app (Phase 1: software only).",
  "author": "Hassan Rehman",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:hardware": "cross-env ENABLE_HARDWARE=1 electron-vite dev",
    "dev:full-stack": "cross-env ENABLE_HARDWARE=1 USE_REAL_SUPERMEMORY=1 USE_REAL_LITELLM=1 electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win nsis dir && node scripts/patch-exe-metadata.js",
    "build:mac": "electron-vite build && electron-builder --mac dmg zip",
    "build:linux": "electron-vite build && electron-builder --linux AppImage deb",
    "publish:win": "electron-vite build && electron-builder --win --publish always",
    "publish:mac": "electron-vite build && electron-builder --mac --publish always",
    "publish:linux": "electron-vite build && electron-builder --linux --publish always",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/check-ollama.js || true"
  },
  "dependencies": {
    "aedes": "^0.51.0",
    "better-sqlite3": "^9.4.3",
    "chokidar": "^3.6.0",
    "dompurify": "^3.1.6",
    "electron-updater": "^6.2.1",
    "keytar": "^7.9.0",
    "marked": "^12.0.0",
    "mqtt": "^5.5.0",
    "msedge-tts": "^2.0.7",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
}
